# Copy to .env and fill in the keys for the providers you choose below.
# Values here are PLACEHOLDERS — never commit real secrets.
#
# QUICKSTART (local, no Google Cloud, no proxy):
#   1) cp .env.example .env
#   2) set OPENROUTER_API_KEY below
#   3) run — see README.md
# The two lines under "Runtime mode" already give you a working no-login local app.

# --- Runtime mode -------------------------------------------------------
# development (default) | production. Keep development for local self-host.
YTRAG_ENV=development
# No-login local mode: auto-authenticate a local developer WITHOUT Google OAuth.
# This is what lets you run with ZERO Google Cloud setup. Forced OFF in production.
# Leave =1 for local self-host.
YTRAG_DEV_LOGIN=1

# --- Provider selection -------------------------------------------------
# LLM (chat):     anthropic | openai | openrouter
# Embeddings:     voyage    | openai | openrouter
# Transcription:  groq      | openai      (audio -> text, Whisper) — OPTIONAL
# The simplest setup routes BOTH chat and embeddings through one OpenRouter key.
YTRAG_LLM_PROVIDER=openrouter
YTRAG_EMBED_PROVIDER=openrouter

# Optional model overrides (sensible defaults are chosen per provider).
# openrouter chat  -> anthropic/claude-sonnet-4.5
# YTRAG_LLM_MODEL=
# openrouter embed -> openai/text-embedding-3-large
# YTRAG_EMBED_MODEL=
# openrouter transcription is not supported; groq/openai only. OPTIONAL.
# YTRAG_TRANSCRIPTION_PROVIDER=groq
# YTRAG_TRANSCRIPTION_MODEL=
# Pre-answer router/intent model — a small fast model cuts time-to-first-token.
# Recommended on openrouter:
# YTRAG_ROUTER_MODEL=google/gemini-2.5-flash-lite

# --- API keys (only the ones your selected providers need) --------------
# One OpenRouter key can serve BOTH chat and embeddings. Get one at
# https://openrouter.ai/keys  (starts with sk-or-).
OPENROUTER_API_KEY=
# Alternatives, if you switch providers above:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# GROQ_API_KEY=

# --- Answer tuning ------------------------------------------------------
# Max answer length in output tokens (default 3000).
# YTRAG_MAX_OUTPUT_TOKENS=3000
# Retrieval relevance FLOOR: max cosine distance a chunk may have to still
# count as context (0=identical .. 2=opposite). Default 1.0. Lower = stricter.
# YTRAG_MAX_RETRIEVAL_DISTANCE=1.0

# --- Storage ------------------------------------------------------------
YTRAG_DATA_DIR=data
YTRAG_CHROMA_DIR=chroma

# --- YouTube fetch (optional) -------------------------------------------
# Running locally on your own residential IP normally needs NO proxy.
# Only set a proxy if YOU hit YouTube rate-limits from a datacenter IP.
# Format e.g. http://USERNAME:PASSWORD@HOST:PORT  # pragma: allowlist secret
# YTRAG_TRANSCRIPT_PROXY=
# YouTube Data API v3 key — OPTIONAL, only used to show a channel's total video
# count in the UI. Ingest works fully without it.
# YTRAG_YOUTUBE_API_KEY=

# --- Telegram bot (optional) --------------------------------------------
# Only needed if you want the Telegram interface. Point this at your own Telegram
# Bot API base. Leave unset to run web + CLI only.
# YTRAG_TELEGRAM_API_BASE=https://api.telegram.org

# --- Logging ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Blank falls back to INFO.
# YTRAG_LOG_LEVEL=INFO
